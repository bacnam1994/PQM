# Thông tin kết nối FTP của bạn
# Đổi tên file này thành .env.local và điền thông tin thực tế của bạn vào
# File .env.local đã được .gitignore bỏ qua nên sẽ an toàn, không bị đưa lên mạng

FTP_HOST=ftp.ten-mien-cua-ban.com
FTP_PORT=21
FTP_USER=ten_dang_nhap_ftp
FTP_PASSWORD=mat_khau_ftp

# Thư mục gốc trên host chứa code web (thường là /public_html, /htdocs hoặc /)
FTP_REMOTE_DIR=/public_html

# Google Drive Integration
VITE_GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id_here
