{
  "name": "pqm-backend",
  "version": "1.0.0",
  "description": "PQM External Backend Authority (Signature, Release, Auth)",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm --prefix ../packages/release-engine run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pqm/release-engine": "file:../packages/release-engine",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}
