PORT=4000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=https://v-biotech.web.app,https://v-biotech.firebaseapp.com,http://localhost:5173

# Firebase Admin Service Account credentials
FIREBASE_PROJECT_ID=v-biotech
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://v-biotech-default-rtdb.asia-southeast1.firebasedatabase.app

# Google Gemini AI Server Key (NEVER EXPOSE IN FRONTEND)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
