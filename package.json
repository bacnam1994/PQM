{
  "name": "hệ-thống-quản-lý-chất-lượng",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc && vite build --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e-ui": "playwright test --ui",
    "deploy": "npm run build && npx firebase deploy --only hosting"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "firebase": "^12.8.0",
    "lucide-react": "0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "7.1.0",
    "recharts": "2.15.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "basic-ftp": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.5.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  }
}
