{
  "rules": {
    ".read": "auth != null && root.child('users/admins/' + auth.uid).exists()",
    ".write": "auth != null && root.child('users/admins/' + auth.uid).exists()",
    
    "users": {
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    
    "audit_logs": {
      "$log_id": {
        ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && !data.exists() && newData.exists()"
      }
    },

    "products": {
      ".read": "auth != null",
      "$item_id": {
        ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && newData.exists()"
      }
    },

    "batches": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "status"],
      "$item_id": {
        ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && newData.exists()"
      }
    },

    "tccs": {
      ".read": "auth != null",
      "$item_id": {
        ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && newData.exists()"
      }
    },
    
    "product_formulas": { 
      ".read": "auth != null", 
      ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && newData.exists()" 
    },

    "raw_materials": { 
      ".read": "auth != null && root.child('users/admins/' + auth.uid).exists()", 
      ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && newData.exists()" 
    },

    "inventoryIn": { 
      ".read": "auth != null && root.child('users/admins/' + auth.uid).exists()", 
      ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && newData.exists()" 
    },

    "inventoryOut": { 
      ".read": "auth != null && root.child('users/admins/' + auth.uid).exists()", 
      ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && newData.exists()" 
    },

    "testResults": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/admins/' + auth.uid).exists() && newData.exists()",
      ".indexOn": ["createdAt", "batchId"]
    },

    "quality_alerts": {
      ".read": "auth != null",
      "$alert_id": {
        ".write": "auth != null && root.child('users/admins/' + auth.uid).exists()"
      }
    },

    "ai_learned_mappings": {
      ".read": "auth != null",
      "$mapping_id": {
        ".write": "auth != null"
      }
    }
  }
}
