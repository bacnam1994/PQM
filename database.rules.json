{
  "rules": {
    ".read": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN')",
    ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN')",

    "users": {
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "audit_logs": {
      "$log_id": {
        ".write": "auth != null && !data.exists() && newData.exists()"
      }
    },

    "products": {
      ".read": "auth != null",
      "$item_id": {
        ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN')"
      }
    },

    "batches": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "status", "productId"],
      "$item_id": {
        ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN' || (root.child('users/' + auth.uid + '/role').val() === 'USER' && newData.exists()))"
      }
    },

    "tccs": {
      ".read": "auth != null",
      ".indexOn": ["productId"],
      "$item_id": {
        ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN')"
      }
    },

    "product_formulas": {
      ".read": "auth != null",
      ".indexOn": ["productId"],
      ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN')"
    },

    "raw_materials": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN')"
    },

    "testResults": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN' || (root.child('users/' + auth.uid + '/role').val() === 'USER' && newData.exists()))",
      ".indexOn": ["createdAt", "batchId"]
    },

    "quality_alerts": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN' || root.child('users/' + auth.uid + '/role').val() === 'USER')"
    },

    "ai_learned_mappings": {
      ".read": "auth != null",
      "$mapping_id": {
        ".write": "auth != null"
      }
    },

    "criteria_aliases": {
      ".read": "auth != null",
      ".indexOn": ["tccsId"],
      "$alias_id": {
        ".write": "auth != null && (root.child('users/admins/' + auth.uid).exists() || root.child('users/' + auth.uid + '/role').val() === 'ADMIN')"
      }
    }
  }
}
